{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3004",
    "build": "next build",
    "start": "next start --port 3004",
    "check": "ultracite check .",
    "prepare-content": "node scripts/prepare-content.mjs",
    "check-links": "node scripts/check-links.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@repo/design-system": "workspace:*",
    "@repo/next-config": "workspace:*",
    "fumadocs-core": "16.16.1",
    "fumadocs-mdx": "15.4.6",
    "fumadocs-openapi": "12.1.1",
    "fumadocs-ui": "16.16.1",
    "geist": "1.7.2",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "4.5.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "next-validate-link": "1.6.7",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3"
  },
  "nx": {
    "sourceRoot": "apps/docs",
    "implicitDependencies": [
      "@repo/api-client"
    ],
    "targets": {
      "prepare-content": {
        "cache": false,
        "dependsOn": [
          {
            "projects": [
              "@repo/api-client"
            ],
            "target": "check-contract"
          }
        ],
        "inputs": [
          "default",
          "^default",
          "rustGlobals"
        ]
      },
      "check-links": {
        "cache": false,
        "dependsOn": [
          "prepare-content"
        ]
      },
      "build": {
        "dependsOn": [
          "^build",
          "check-links"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "^typecheck",
          "prepare-content"
        ]
      },
      "dev": {
        "dependsOn": [
          "prepare-content"
        ]
      },
      "test": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "pnpm test:docs"
        }
      },
      "smoke": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "node tools/docs-standalone.mjs"
        }
      }
    }
  }
}
