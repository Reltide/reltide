{
  "name": "reltide-api",
  "projectType": "application",
  "tags": ["scope:backend", "language:rust"],
  "implicitDependencies": ["reltide-domain"],
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "rustGlobals"]
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo build -p reltide-api --locked",
        "cwd": "{workspaceRoot}"
      },
      "inputs": ["default", "^default"],
      "cache": false
    },
    "fmt": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt -p reltide-api -- --check",
        "cwd": "{workspaceRoot}"
      },
      "inputs": ["default", "^default"],
      "cache": false
    },
    "clippy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo clippy -p reltide-api --all-targets --locked -- -D warnings",
        "cwd": "{workspaceRoot}"
      },
      "inputs": ["default", "^default"],
      "cache": false
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test -p reltide-api --locked",
        "cwd": "{workspaceRoot}"
      },
      "inputs": ["default", "^default"],
      "cache": false
    }
  }
}
