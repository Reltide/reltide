{
  "name": "reltide-capacity-probe",
  "projectType": "application",
  "tags": ["scope:backend", "language:rust"],
  "namedInputs": { "default": ["{projectRoot}/**/*", "rustGlobals"] },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default"],
      "options": {
        "command": "cargo build -p reltide-capacity-probe --locked",
        "cwd": ""
      }
    },
    "fmt": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default"],
      "options": {
        "command": "cargo fmt -p reltide-capacity-probe -- --check",
        "cwd": ""
      }
    },
    "clippy": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default"],
      "options": {
        "command": "cargo clippy -p reltide-capacity-probe --all-targets --locked -- -D warnings",
        "cwd": ""
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default"],
      "options": {
        "command": "cargo test -p reltide-capacity-probe --locked",
        "cwd": ""
      }
    }
  }
}
