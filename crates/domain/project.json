{
  "name": "reltide-domain",
  "projectType": "library",
  "tags": ["scope:backend", "language:rust"],
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "rustGlobals"]
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo build -p reltide-domain --locked",
        "cwd": "{workspaceRoot}"
      },
      "inputs": ["default", "^default"],
      "cache": false
    },
    "fmt": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt -p reltide-domain -- --check",
        "cwd": "{workspaceRoot}"
      },
      "inputs": ["default", "^default"],
      "cache": false
    },
    "clippy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo clippy -p reltide-domain --all-targets --locked -- -D warnings",
        "cwd": "{workspaceRoot}"
      },
      "inputs": ["default", "^default"],
      "cache": false
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test -p reltide-domain --locked",
        "cwd": "{workspaceRoot}"
      },
      "inputs": ["default", "^default"],
      "cache": false
    }
  }
}
