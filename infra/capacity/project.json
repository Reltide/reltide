{
  "name": "capacity-experiment",
  "root": "infra/capacity",
  "projectType": "application",
  "implicitDependencies": [
    "app",
    "web",
    "docs",
    "reltide-api",
    "reltide-capacity-probe"
  ],
  "targets": {
    "host-offline": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "default",
        "rustGlobals",
        "{workspaceRoot}/tools/capacity/**/*"
      ],
      "options": {
        "command": "pnpm exec vitest run tools/capacity/host.test.mjs tools/capacity/config.test.mjs"
      }
    },
    "host-preflight": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "default",
        "rustGlobals",
        "{workspaceRoot}/tools/capacity/**/*"
      ],
      "options": { "command": "node tools/capacity/host.mjs preflight" }
    },
    "check-config": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "default",
        "rustGlobals",
        "^default",
        "{workspaceRoot}/tools/capacity/**/*",
        "{workspaceRoot}/.dockerignore"
      ],
      "options": { "command": "node tools/capacity/config.mjs check-config" }
    },
    "build-images": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "default",
        "rustGlobals",
        "^default",
        "{workspaceRoot}/tools/capacity/**/*",
        "{workspaceRoot}/.dockerignore"
      ],
      "options": { "command": "node tools/capacity/build.mjs" }
    },
    "integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "default",
        "rustGlobals",
        "^default",
        "{workspaceRoot}/tools/capacity/**/*",
        "{workspaceRoot}/.dockerignore"
      ],
      "options": { "command": "node tools/capacity/integration.mjs" }
    }
  }
}
