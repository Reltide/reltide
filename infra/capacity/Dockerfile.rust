FROM rust:1.99.0-bookworm@sha256:b36c246742b4d323472588f789601be34eb4af053255e2af53969078ee8dcec7 AS build
WORKDIR /workspace
COPY . .
RUN cargo build --locked --release -p reltide-api -p reltide-capacity-probe
FROM debian:bookworm-slim@sha256:a4672c0cb26fbdde88e38fa2dfb6c681942306680e41e4378b28770b6e79ee91
ARG BINARY
COPY --from=build /workspace/target/release/${BINARY} /usr/local/bin/reltide
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/reltide"]
