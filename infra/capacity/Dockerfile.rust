FROM rust:1.99.0-bookworm@sha256:37f847a196b12e0c6298d265b99075a8bc9176f2bb22e434b4340ab7342ca3af AS build
WORKDIR /workspace
COPY . .
RUN cargo build --locked --release -p reltide-api -p reltide-capacity-probe
FROM debian:bookworm-slim@sha256:f3034a6ec3c1205360777c4aae76234998866ad18806ae62b63a3f84ccad782b
ARG BINARY
COPY --from=build /workspace/target/release/${BINARY} /usr/local/bin/reltide
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/reltide"]
