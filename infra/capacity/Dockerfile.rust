FROM rust:1.99.1-bookworm@sha256:5f29c3b4cb8ad8c6f10df979595582dd67dd146ffebc70718e24ff2e5b4a194d AS build
WORKDIR /workspace
COPY . .
RUN cargo build --locked --release -p reltide-api -p reltide-capacity-probe
FROM debian:bookworm-slim@sha256:ec31d744f83f4a73447ba045aaab9409997efe5cc706eca4890c1be36cc1606a
ARG BINARY
COPY --from=build /workspace/target/release/${BINARY} /usr/local/bin/reltide
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/reltide"]
