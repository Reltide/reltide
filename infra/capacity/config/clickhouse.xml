<clickhouse>
  <listen_host>0.0.0.0</listen_host>
  <max_server_memory_usage>536870912</max_server_memory_usage>
  <background_pool_size>1</background_pool_size>
  <background_merges_mutations_concurrency_ratio>1</background_merges_mutations_concurrency_ratio>
  <background_schedule_pool_size>2</background_schedule_pool_size>
  <background_buffer_flush_schedule_pool_size>1</background_buffer_flush_schedule_pool_size>
  <background_message_broker_schedule_pool_size>1</background_message_broker_schedule_pool_size>
  <background_distributed_schedule_pool_size>1</background_distributed_schedule_pool_size>
  <merge_tree>
    <number_of_free_entries_in_pool_to_execute_mutation>0</number_of_free_entries_in_pool_to_execute_mutation>
    <number_of_free_entries_in_pool_to_lower_max_size_of_merge>0</number_of_free_entries_in_pool_to_lower_max_size_of_merge>
    <number_of_free_entries_in_pool_to_execute_optimize_entire_partition>0</number_of_free_entries_in_pool_to_execute_optimize_entire_partition>
    <merge_with_ttl_timeout>300</merge_with_ttl_timeout>
  </merge_tree>
  <logger><level>warning</level><console>1</console><log remove="remove"/><errorlog remove="remove"/></logger>
  <query_log><ttl>event_date + INTERVAL 3 DAY</ttl><flush_interval_milliseconds>7500</flush_interval_milliseconds></query_log>
  <asynchronous_insert_log><ttl>event_date + INTERVAL 3 DAY</ttl></asynchronous_insert_log>
  <trace_log remove="remove"/>
  <query_thread_log remove="remove"/>
  <query_views_log remove="remove"/>
  <background_schedule_pool_log remove="remove"/>
  <error_log remove="remove"/>
  <instrumentation_trace_log remove="remove"/>
  <query_metric_log remove="remove"/>
  <iceberg_metadata_log remove="remove"/>
  <delta_lake_metadata_log remove="remove"/>
  <crash_log remove="remove"/>
  <backup_log remove="remove"/>
  <s3queue_log remove="remove"/>
  <blob_storage_log remove="remove"/>
  <aggregated_zookeeper_log remove="remove"/>
  <zookeeper_connection_log remove="remove"/>
  <metric_log remove="remove"/>
  <asynchronous_metric_log remove="remove"/>
  <processors_profile_log remove="remove"/>
  <opentelemetry_span_log remove="remove"/>
  <text_log remove="remove"/>
  <part_log remove="remove"/>
</clickhouse>
